{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@i3cm/lib": [
        "./lib/index.ts"
      ],
      "@i3cm/base": [
        "./base/index.ts"
      ]
    }
  },
  "include": [
    "lib/**/*.ts",
    "base/**/*.ts",
    "modules/**/*.ts"
  ]
}
